#!/usr/bin/env python3
# ca ADDR [N]: the disassembly from ADDR to the Nth call (default 1), to read a call's arguments
import sys,re
s=int(sys.argv[1],16); n=int(sys.argv[2]) if len(sys.argv)>2 else 1
out=False; c=0
for line in open('/root/gh/game.dis'):
    m=re.match(r'^ *([0-9a-f]+):',line)
    if not m: continue
    a=int(m.group(1),16)
    if a>=s:
        sys.stdout.write(line)
        if 'call' in line:
            c+=1
            if c>=n: break
